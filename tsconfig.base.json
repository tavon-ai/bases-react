{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@bases-react/core": ["packages/bases-core/src/index.ts"],
      "@bases-react/fs": ["packages/bases-fs/src/index.ts"],
      "@bases-react/tanstack": ["packages/bases-tanstack/src/index.ts"],
      "@bases-react/react": ["packages/bases-react/src/index.tsx"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  }
}
